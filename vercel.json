{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/pdf/extract-worksheet.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/pdfjs-dist/**"
    },
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/pdfjs-dist/**"
    },
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
